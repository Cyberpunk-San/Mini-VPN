#!/usr/bin/env python3
"""minivpn-admin - manage a minivpn server: devices, licenses, web dashboard.

Standard library only. Normally run as root: it edits /etc/minivpn and talks
to the server's control socket. Set MINIVPN_ETC to use another directory and
MINIVPN_BIN to point at a specific minivpn binary.
"""

import argparse
import base64
import contextlib
