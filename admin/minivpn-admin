<div class="row"><button class="btn" value="cancel" formnovalidate>Cancel</button><button class="btn primary" id="add-go" value="ok">Create</button></div></form></dialog>

<dialog id="dlg-config"><div class="dlg"><h3 id="cfg-title">Device configuration</h3>
<p>Copy this file to the device and connect with <code>sudo minivpn client --config FILE</code>. It contains the device's secret key.</p>
<pre id="cfg-text"></pre><div class="row"><button class="btn" id="cfg-copy">Copy</button><a class="btn" id="cfg-dl" download>Download</a><button class="btn primary" id="cfg-close">Done</button></div></div></dialog>

<dialog id="dlg-lic"><form class="dlg" method="dialog" id="form-lic"><h3>Install license</h3>
<p>Paste the contents of the license file you received.</p><textarea id="lic-text" required></textarea>
<div class="error" id="lic-err" hidden></div>
<div class="row"><button class="btn" value="cancel" formnovalidate>Cancel</button><button class="btn primary" value="ok">Install</button></div></form></dialog>

<dialog id="dlg-confirm"><form class="dlg" method="dialog"><h3 id="cf-title"></h3><p id="cf-text"></p>
<div class="row"><button class="btn" value="cancel">Cancel</button><button class="btn primary" id="cf-ok" value="ok">Confirm</button></div></form></dialog>
<div class="toast" id="toast" role="status"></div>

<script nonce="__NONCE__">
