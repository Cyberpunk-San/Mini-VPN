  prevSample = {t: now, cur};
}

function render(o) {
  last = o; sample(o);
  const srv = o.server, lic = o.license, online = o.devices.filter(d => d.online).length;
  $("edition").textContent = lic.edition.charAt(0).toUpperCase() + lic.edition.slice(1);
  $("edition").className = "chip" + (lic.edition !== "community" ? " biz" : "");
  $("srv-dot").className = "dot " + (srv ? "on" : "off");
  $("srv-text").textContent = srv ? "Server running" : "Server offline";

  const banners = $("banners"); banners.replaceChildren();
  if (!srv) banners.append(el("div", {class: "banner bad"}, "The VPN server is not running. Devices cannot connect. Start it with: systemctl start minivpn-server"));
  if (lic.status === "expired" || lic.status === "invalid") banners.append(el("div", {class: "banner bad"}, lic.message));
  if (srv && srv.devices_over_limit) banners.append(el("div", {class: "banner"}, srv.devices_over_limit + " device(s) cannot connect because the license limit is reached."));
  if (!o.endpoint) banners.append(el("div", {class: "banner"}, "Set 'endpoint' in server.conf so device configs know where to connect."));

  $("s-online").textContent = online;
  $("s-online-sub").textContent = "of " + o.devices.length + " registered";
  $("s-used").textContent = o.active_devices + " / " + lic.max_devices;
  $("s-meter").style.width = Math.min(100, 100 * o.active_devices / Math.max(1, lic.max_devices)) + "%";
  let rin = 0, rout = 0; for (const r of Object.values(rates)) { rin += r.rx; rout += r.tx; }
  $("s-rate").textContent = rate(rin + rout);
  $("s-rate-sub").textContent = "in " + rate(rin) + " · out " + rate(rout);
  $("s-uptime").textContent = srv ? dur(srv.uptime) : "–";
  $("s-endpoint").textContent = o.endpoint ? o.endpoint + " · " + o.subnet : o.subnet;

  const q = $("filter").value.trim().toLowerCase(), rows = $("rows"); rows.replaceChildren();
  const list = o.devices.filter(d => !q || d.name.toLowerCase().includes(q) || d.ip.includes(q))
    .sort((a, b) => (b.online - a.online) || a.name.localeCompare(b.name));
  const nowSec = Date.now() / 1000;
  for (const d of list) {
    const r = rates[d.id + d.session], disabled = d.status !== "active";
    const name = el("div", {class: "d"}, el("span", {class: "dot " + (d.online ? "on" : "idle"), title: d.online ? "online" : "offline"}), d.name);
    if (disabled) name.append(el("span", {class: "tag"}, "disabled"));
    const acts = el("td", {class: "actions"},
      el("button", {class: "btn small", "data-act": "config", "data-name": d.name}, "Config"),
      el("button", {class: "btn small", "data-act": disabled ? "enable" : "disable", "data-name": d.name}, disabled ? "Enable" : "Disable"));
    if (d.online) acts.append(el("button", {class: "btn small", "data-act": "kick", "data-name": d.name}, "Disconnect"));
    acts.append(el("button", {class: "btn small danger", "data-act": "revoke", "data-name": d.name}, "Revoke"));
    rows.append(el("tr", {},
      el("td", {class: "name"}, name), el("td", {}, d.ip),
      el("td", {class: d.online ? "" : "muted"}, d.online ? d.endpoint : "offline"),
      el("td", {class: "muted"}, d.online ? dur(nowSec - d.connected_at) : "–"),
      el("td", {}, d.online ? bytes(d.rx_bytes) : "–"), el("td", {}, d.online ? bytes(d.tx_bytes) : "–"),
      el("td", {class: "muted"}, r ? rate(r.rx + r.tx) : "–"), acts));
  }
  $("empty").hidden = o.devices.length > 0;

  const dl = $("lic"); dl.replaceChildren();
  const add = (k, v) => dl.append(el("dt", {}, k), el("dd", {}, v));
  add("Edition", $("edition").textContent);
  if (lic.status === "valid") { add("Licensed to", lic.customer); add("Valid until", lic.expires); add("License ID", lic.license_id); }
  add("Device limit", String(lic.max_devices));
  $("lic-msg").textContent = lic.status === "valid" ? "" : "Upgrade to Business for more devices and priority support.";

  const audit = $("audit"); audit.replaceChildren();
  for (const e of o.audit) {
    const when = new Date(e.time * 1000).toLocaleString([], {month: "short", day: "numeric", hour: "2-digit", minute: "2-digit"});
    audit.append(el("li", {}, el("time", {}, when), el("span", {}, e.action + (e.device ? " " + e.device : "") + (e.detail ? " · " + e.detail : "")),
      el("span", {class: "who"}, e.actor)));
  }
  if (!o.audit.length) audit.append(el("li", {class: "muted"}, "No activity yet."));
}

async function refresh() { try { render(await api("GET", "/api/overview")); } catch (e) { if (e.message !== "signed out") $("srv-text").textContent = "Dashboard error: " + e.message; } }

function showConfig(name, text) {
  $("cfg-title").textContent = "Configuration for " + name; $("cfg-text").textContent = text;
  const a = $("cfg-dl"); URL.revokeObjectURL(a.href); a.href = URL.createObjectURL(new Blob([text], {type: "text/plain"})); a.download = name + ".conf";
  $("dlg-config").showModal();
}
function confirmDlg(title, text, label) {
  return new Promise(res => { $("cf-title").textContent = title; $("cf-text").textContent = text; $("cf-ok").textContent = label;
    const d = $("dlg-confirm"); d.returnValue = ""; d.showModal(); d.addEventListener("close", () => res(d.returnValue === "ok"), {once: true}); });
}

$("rows").addEventListener("click", async (ev) => {
  const b = ev.target.closest("button[data-act]"); if (!b) return;
  const act = b.dataset.act, name = b.dataset.name;
  try {
    if (act === "config") { const r = await fetch("/api/devices/" + encodeURIComponent(name) + "/config", {credentials: "same-origin"});
      if (!r.ok) throw new Error((await r.json()).error); return showConfig(name, await r.text()); }
