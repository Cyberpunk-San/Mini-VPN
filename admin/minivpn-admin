def hash_password(password):
    salt = secrets.token_bytes(16)
    digest = hashlib.pbkdf2_hmac("sha256", password.encode(), salt, PBKDF2_ITERATIONS)
    return "pbkdf2_sha256${}${}${}".format(
        PBKDF2_ITERATIONS, base64.b64encode(salt).decode(), base64.b64encode(digest).decode())


def verify_password(password, stored):
    try:
        scheme, iterations, salt, digest = stored.split("$")
        if scheme != "pbkdf2_sha256":
            return False
        candidate = hashlib.pbkdf2_hmac("sha256", password.encode(), base64.b64decode(salt), int(iterations))
        return hmac.compare_digest(candidate, base64.b64decode(digest))
    except (ValueError, TypeError):
        return False


class WebState:
    SESSION_IDLE = 30 * 60
    SESSION_MAX = 12 * 3600
    MAX_FAILURES = 5
    LOCKOUT = 5 * 60

    def __init__(self, install, secure_cookie, quiet=False):
        self.inst = install
        self.secure_cookie = secure_cookie
        self.quiet = quiet
        self.sessions = {}
        self.failures = {}
        self.lock = threading.Lock()

    def credentials(self):
        try:
            with open(self.inst.admin_conf, encoding="utf-8") as f:
                return json.load(f)
        except (FileNotFoundError, ValueError):
            return None

    def login(self, ip, username, password):
        now = time.time()
        with self.lock:
            fails = [t for t in self.failures.get(ip, []) if now - t < self.LOCKOUT]
            self.failures[ip] = fails
            if len(fails) >= self.MAX_FAILURES:
                return None, "Too many failed attempts. Try again in a few minutes."
        creds = self.credentials()
        if not creds:
            return None, "No admin password is set. Run: sudo minivpn-admin passwd"
        user_ok = hmac.compare_digest(username.encode(), creds.get("username", "admin").encode())
        if not (verify_password(password, creds.get("password", "")) and user_ok):
            with self.lock:
                self.failures.setdefault(ip, []).append(now)
            return None, "Wrong username or password."
        token = secrets.token_urlsafe(32)
        with self.lock:
            self.failures.pop(ip, None)
            self.sessions[token] = {"user": username, "csrf": secrets.token_urlsafe(24),
                                    "created": now, "seen": now}
        return token, None

    def session(self, token):
        if not token:
            return None
        now = time.time()
        with self.lock:
            s = self.sessions.get(token)
            if not s:
                return None
            if now - s["seen"] > self.SESSION_IDLE or now - s["created"] > self.SESSION_MAX:
                del self.sessions[token]
                return None
            s["seen"] = now
            return s

    def logout(self, token):
        with self.lock:
            self.sessions.pop(token, None)


def make_handler(state):
    class Handler(http.server.BaseHTTPRequestHandler):
        server_version = "minivpn-admin"
        sys_version = ""

        def log_message(self, fmt, *args):
            if not state.quiet:
                sys.stderr.write("%s %s %s\n" % (self.log_date_time_string(), self.client_address[0], fmt % args))

        # -- plumbing -------------------------------------------------------

        def _send(self, code, body, ctype="application/json", headers=None):
            data = body if isinstance(body, bytes) else body.encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("X-Frame-Options", "DENY")
            self.send_header("Referrer-Policy", "no-referrer")
            for k, v in (headers or {}).items():
                self.send_header(k, v)
            self.end_headers()
            self.wfile.write(data)

        def _json(self, code, obj):
            self._send(code, json.dumps(obj))

        def _page(self, code, template, csrf="", extra=None):
            nonce = secrets.token_urlsafe(16)
            html_text = template.replace("__NONCE__", nonce).replace("__CSRF__", csrf)
            for k, v in (extra or {}).items():
                html_text = html_text.replace(k, v)
            csp = (f"default-src 'none'; script-src 'nonce-{nonce}'; style-src 'nonce-{nonce}'; "
                   "connect-src 'self'; img-src 'self' data:; form-action 'self'; frame-ancestors 'none'; base-uri 'none'")
            self._send(code, html_text, "text/html; charset=utf-8", {"Content-Security-Policy": csp})

        def _token(self):
            for part in self.headers.get("Cookie", "").split(";"):
                k, _, v = part.strip().partition("=")
                if k == "minivpn_session":
                    return v
            return None

        def _body(self, limit=65536):
            length = int(self.headers.get("Content-Length") or 0)
            if length > limit:
                raise AdminError("request too large")
            return self.rfile.read(length) if length else b""

        def _same_origin(self):
            origin = self.headers.get("Origin")
            return origin is None or urllib.parse.urlparse(origin).netloc == self.headers.get("Host")

        def _admin(self, session):
            return Admin(state.inst, f"web:{session['user']}@{self.client_address[0]}")

        # -- routes ---------------------------------------------------------

        def do_GET(self):
            path = urllib.parse.urlparse(self.path).path
            session = state.session(self._token())
            if path == "/":
                if not session:
                    return self._page(200, LOGIN_HTML, extra={"__ERROR__": ""})
                return self._page(200, APP_HTML, csrf=session["csrf"])
            if not session:
                return self._json(401, {"error": "not signed in"})
            try:
                if path == "/api/overview":
                    return self._json(200, self._admin(session).overview())
                m = re.fullmatch(r"/api/devices/([A-Za-z0-9._-]{1,32})/config", path)
                if m:
                    text = self._admin(session).show_config(m.group(1))
                    return self._send(200, text, "text/plain; charset=utf-8",
                                      {"Content-Disposition": f'attachment; filename="{m.group(1)}.conf"'})
            except AdminError as e:
                return self._json(400, {"error": str(e)})
            self._json(404, {"error": "not found"})

        def do_POST(self):
            path = urllib.parse.urlparse(self.path).path
            if not self._same_origin():
                return self._json(403, {"error": "cross-origin request refused"})
            try:
                body = self._body()
            except AdminError as e:
                return self._json(413, {"error": str(e)})

            if path == "/login":
                form = urllib.parse.parse_qs(body.decode(errors="replace"))
                token, err = state.login(self.client_address[0], form.get("username", [""])[0],
                                         form.get("password", [""])[0])
                if not token:
                    return self._page(401, LOGIN_HTML, extra={"__ERROR__": f'<p class="error">{err}</p>'})
                cookie = f"minivpn_session={token}; Path=/; HttpOnly; SameSite=Strict"
                if state.secure_cookie:
                    cookie += "; Secure"
                Admin(state.inst, f"web:{form['username'][0]}@{self.client_address[0]}").audit("login")
                return self._send(303, "", "text/plain", {"Location": "/", "Set-Cookie": cookie})

            session = state.session(self._token())
            if not session:
                return self._json(401, {"error": "not signed in"})
            sent = self.headers.get("X-CSRF-Token", "").encode("utf-8", "replace")
            if not hmac.compare_digest(sent, session["csrf"].encode()):
                return self._json(403, {"error": "missing or invalid CSRF token"})

            try:
                data = json.loads(body or b"{}")
            except ValueError:
                return self._json(400, {"error": "invalid JSON"})
            admin = self._admin(session)
            try:
                if path == "/logout":
                    state.logout(self._token())
                    return self._json(200, {"ok": True})
                if path == "/api/devices":
                    device, config, note = admin.add_device(str(data.get("name", "")).strip(),
                                                            (data.get("ip") or "").strip() or None)
                    return self._json(200, {"device": device.public(), "config": config, "note": note})
                if path == "/api/license":
                    info, note = admin.install_license(str(data.get("text", "")))
                    return self._json(200, {"license": info, "note": note})
                m = re.fullmatch(r"/api/devices/([A-Za-z0-9._-]{1,32})/(enable|disable|revoke|kick)", path)
                if m:
                    name, action = m.groups()
                    note = {"enable": lambda: admin.set_status(name, "active"),
                            "disable": lambda: admin.set_status(name, "disabled"),
                            "revoke": lambda: admin.revoke(name),
                            "kick": lambda: admin.kick(name)}[action]()
                    return self._json(200, {"ok": True, "note": note})
            except AdminError as e:
                return self._json(400, {"error": str(e)})
            self._json(404, {"error": "not found"})

    return Handler


def serve(install, listen, cert=None, key=None):
    host, _, port = listen.rpartition(":")
    host = host.strip("[]") or "127.0.0.1"
    state = WebState(install, secure_cookie=bool(cert))
    httpd = http.server.ThreadingHTTPServer((host, int(port)), make_handler(state))
    httpd.daemon_threads = True
    scheme = "http"
    if cert:
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.minimum_version = ssl.TLSVersion.TLSv1_2
        ctx.load_cert_chain(cert, key)
        httpd.socket = ctx.wrap_socket(httpd.socket, server_side=True)
        scheme = "https"
    if not cert and not ipaddress.ip_address(host).is_loopback:
        print("WARNING: serving the dashboard without TLS on a non-loopback address. "
              "Use --tls-cert/--tls-key, or keep it on 127.0.0.1 and use an SSH tunnel.", file=sys.stderr)
    if not state.credentials():
        print("WARNING: no admin password set yet; run: sudo minivpn-admin passwd", file=sys.stderr)
    print(f"minivpn dashboard on {scheme}://{host}:{port}/", file=sys.stderr, flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        httpd.server_close()


