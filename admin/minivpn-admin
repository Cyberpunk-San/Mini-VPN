}
function bytes(n) { if (n == null) return "–"; const u = ["B","KB","MB","GB","TB"]; let i = 0;
  while (n >= 1024 && i < u.length - 1) { n /= 1024; i++; } return (i ? n.toFixed(1) : n.toFixed(0)) + " " + u[i]; }
function rate(bps) { if (!bps) return "0 bit/s"; const u = ["bit/s","kbit/s","Mbit/s","Gbit/s"]; let v = bps * 8, i = 0;
  while (v >= 1000 && i < u.length - 1) { v /= 1000; i++; } return v.toFixed(v < 10 && i ? 1 : 0) + " " + u[i]; }
