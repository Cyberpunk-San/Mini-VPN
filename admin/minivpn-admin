def fmt_bytes(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def fmt_age(seconds):
    seconds = int(seconds)
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}h{seconds % 3600 // 60:02d}m"
    return f"{seconds // 86400}d{seconds % 86400 // 3600}h"


def read_password(args, prompt="New admin password: "):
    if args.password_stdin:
        return sys.stdin.readline().rstrip("\n")
    first = getpass.getpass(prompt)
    if getpass.getpass("Repeat: ") != first:
        raise AdminError("passwords do not match")
    return first


def set_password(inst, username, password):
    if len(password) < MIN_PASSWORD:
        raise AdminError(f"use at least {MIN_PASSWORD} characters")
    atomic_write(inst.admin_conf, json.dumps({"username": username, "password": hash_password(password)}) + "\n",
                 mode=0o600)


def cmd_init(inst, args):
    os.makedirs(inst.etc, mode=0o750, exist_ok=True)
    try:
        net = ipaddress.ip_network(args.subnet, strict=True)
    except ValueError as e:
        raise AdminError(f"invalid --subnet: {e}")
    if not 16 <= net.prefixlen <= 29:
        raise AdminError("--subnet must be between /16 and /29")
    if os.path.exists(inst.server_conf) and not args.force:
        raise AdminError(f"{inst.server_conf} already exists (use --force to overwrite)")
    user = args.user
    if user:
        try:
            pwd.getpwnam(user)
        except KeyError:
            print(f"note: user '{user}' does not exist; the server will refuse to start until it does "
                  f"(create it with: useradd --system --no-create-home --shell /usr/sbin/nologin {user})")
    conf = (
        "# minivpn server configuration (see `minivpn --help`)\n"
        f"endpoint = {args.endpoint}        # public host/IP clients connect to\n"
        f"port = {args.port}\n"
        f"subnet = {net}\n"
        "mtu = 1400\n"
        "interface = mvpn0\n"
        "client_to_client = yes\n"
        + (f"user = {user}\n" if user else "# user = minivpn\n")
        + f"devices = {os.path.join(inst.etc, 'devices')}\n"
        f"license = {os.path.join(inst.etc, 'license.key')}\n"
        "control_socket = /run/minivpn/control.sock\n"
    )
    atomic_write(inst.server_conf, conf, mode=0o644)
    # The daemon drops to `user` but re-reads the registry and license on
    # reload, so its group needs to traverse this directory.
    gid = inst.service_gid
    if gid is not None and os.geteuid() == 0:
        os.chown(inst.etc, 0, gid)
    os.chmod(inst.etc, 0o750)
    if not os.path.exists(inst.devices_path):
        inst.save_devices([])
    print(f"wrote {inst.server_conf}")
    if not os.path.exists(inst.admin_conf):
        if args.password_stdin or sys.stdin.isatty():
            set_password(inst, "admin", read_password(args, "Choose a dashboard password for 'admin': "))
            print(f"dashboard login: admin (password saved to {inst.admin_conf})")
        else:
            print("set a dashboard password with: minivpn-admin passwd")
    print("next: minivpn-admin add <device-name>   then start the server: systemctl enable --now minivpn-server")


def cmd_add(inst, args):
    device, config, note = Admin(inst, "cli").add_device(args.name, args.ip)
    if args.output:
        atomic_write(args.output, config, mode=0o600)
        print(f"added {device.name} ({device.ip}); config written to {args.output}", file=sys.stderr)
    else:
        sys.stdout.write(config)
        print(f"added {device.name} ({device.ip}); copy the config above to the device", file=sys.stderr)
    print(note, file=sys.stderr)


def cmd_list(inst, args):
    ov = Admin(inst, "cli").overview()
    if args.json:
        print(json.dumps(ov["devices"], indent=2))
        return
    if not ov["devices"]:
        print("no devices yet; add one with: minivpn-admin add <name>")
        return
    fmt = "{:<22} {:<15} {:<9} {:<8} {:<22} {:>10} {:>10}"
    print(fmt.format("NAME", "TUNNEL IP", "STATUS", "ONLINE", "CONNECTED FROM", "RECEIVED", "SENT"))
    for d in ov["devices"]:
        online = "yes" if d["online"] else "-"
        print(fmt.format(d["name"], d["ip"], d["status"], online, d.get("endpoint", "-"),
                         fmt_bytes(d["rx_bytes"]) if d["online"] else "-",
                         fmt_bytes(d["tx_bytes"]) if d["online"] else "-"))
    lic = ov["license"]
    print(f"\n{ov['active_devices']} of {lic['max_devices']} licensed devices active ({lic['edition']} edition)")


def cmd_status(inst, args):
    admin = Admin(inst, "cli")
    ov = admin.overview()
    if args.json:
        print(json.dumps(ov, indent=2))
        return
    srv, lic = ov["server"], ov["license"]
    if srv:
        online = sum(d["online"] for d in ov["devices"])
        print(f"server:   running {srv['version']}, up {fmt_age(srv['uptime'])}, "
              f"{srv['interface']} {srv['subnet']} on UDP {srv['port']}")
        print(f"devices:  {online} online, {srv['devices_loaded']} authorised")
        if srv["devices_over_limit"]:
            print(f"WARNING:  {srv['devices_over_limit']} device(s) not loaded because of the license limit")
    else:
        print("server:   not running (start it with: systemctl start minivpn-server)")
    print(f"license:  {lic['message']}")


def cmd_set_status(status):
    def run(inst, args):
        print(Admin(inst, "cli").set_status(args.name, status))
    return run


def cmd_revoke(inst, args):
    if not args.yes and sys.stdin.isatty():
        if input(f"Permanently revoke '{args.name}'? Its config file will stop working. [y/N] ").lower() != "y":
            print("cancelled")
            return
    print(Admin(inst, "cli").revoke(args.name))


def cmd_kick(inst, args):
    print(Admin(inst, "cli").kick(args.name))


def cmd_show(inst, args):
    sys.stdout.write(Admin(inst, "cli").show_config(args.name))


def cmd_license(inst, args):
    admin = Admin(inst, "cli")
    if args.action == "show":
        print(admin.license()["message"])
        return
    if not args.file:
        raise AdminError("usage: minivpn-admin license install FILE")
    with open(args.file, encoding="utf-8") as f:
        info, note = admin.install_license(f.read())
    print(f"installed: {info['message']}\n{note}")


def cmd_reload(inst, args):
    print(Admin(inst, "cli").notify_daemon())


def cmd_passwd(inst, args):
    os.makedirs(inst.etc, mode=0o750, exist_ok=True)
    set_password(inst, args.username, read_password(args))
    Admin(inst, "cli").audit("passwd", "", args.username)
    print(f"dashboard password for '{args.username}' updated")


def cmd_audit(inst, args):
    for e in Admin(inst, "cli").audit_tail(args.limit):
        when = dt.datetime.fromtimestamp(e["time"]).strftime("%Y-%m-%d %H:%M:%S")
        print(f"{when}  {e['actor']:<28} {e['action']:<8} {e.get('device', ''):<20} {e.get('detail', '')}")


def cmd_web(inst, args):
    inst.conf  # fail early if not initialised
    if bool(args.tls_cert) != bool(args.tls_key):
        raise AdminError("--tls-cert and --tls-key go together")
    serve(inst, args.listen, args.tls_cert, args.tls_key)


def main(argv=None):
    p = argparse.ArgumentParser(prog="minivpn-admin", description="Manage a minivpn server.")
    p.add_argument("--etc", help="configuration directory (default $MINIVPN_ETC or /etc/minivpn)")
    p.add_argument("--version", action="version", version=f"minivpn-admin {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True, metavar="COMMAND")

    s = sub.add_parser("init", help="create server.conf, the device registry and a dashboard password")
    s.add_argument("--endpoint", required=True, help="public hostname or IP that devices connect to")
    s.add_argument("--subnet", default="10.8.0.0/24")
    s.add_argument("--port", type=int, default=51900)
    s.add_argument("--user", default="minivpn", help="unprivileged user the server runs as ('' for none)")
    s.add_argument("--force", action="store_true")
    s.add_argument("--password-stdin", action="store_true")
    s.set_defaults(func=cmd_init)

    s = sub.add_parser("add", help="register a device and print its config file")
    s.add_argument("name")
    s.add_argument("--ip", help="fixed tunnel address (default: next free)")
    s.add_argument("-o", "--output", help="write the config to this file instead of stdout")
    s.set_defaults(func=cmd_add)

    s = sub.add_parser("list", help="list devices with online status")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_list)

    s = sub.add_parser("status", help="server, license and connection summary")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_status)

    for name, status in (("enable", "active"), ("disable", "disabled")):
        s = sub.add_parser(name, help=f"{name} a device (keeps its address and key)")
        s.add_argument("name")
        s.set_defaults(func=cmd_set_status(status))

    s = sub.add_parser("revoke", help="delete a device permanently")
    s.add_argument("name")
    s.add_argument("-y", "--yes", action="store_true")
    s.set_defaults(func=cmd_revoke)

    s = sub.add_parser("kick", help="disconnect a device now (it may reconnect)")
    s.add_argument("name")
    s.set_defaults(func=cmd_kick)

    s = sub.add_parser("show", help="print a device's config file again")
    s.add_argument("name")
    s.set_defaults(func=cmd_show)

    s = sub.add_parser("license", help="show or install a license")
    s.add_argument("action", choices=["show", "install"])
    s.add_argument("file", nargs="?")
    s.set_defaults(func=cmd_license)

    s = sub.add_parser("reload", help="make the running server re-read devices and license")
    s.set_defaults(func=cmd_reload)

    s = sub.add_parser("passwd", help="set the dashboard password")
    s.add_argument("--username", default="admin")
    s.add_argument("--password-stdin", action="store_true")
    s.set_defaults(func=cmd_passwd)

    s = sub.add_parser("audit", help="show the administrator activity log")
    s.add_argument("-n", "--limit", type=int, default=50)
    s.set_defaults(func=cmd_audit)

    s = sub.add_parser("web", help="run the web dashboard")
    s.add_argument("--listen", default="127.0.0.1:8090", help="address:port (default 127.0.0.1:8090)")
    s.add_argument("--tls-cert")
    s.add_argument("--tls-key")
    s.set_defaults(func=cmd_web)

    args = p.parse_args(argv)
    inst = Install(args.etc)
    try:
        args.func(inst, args)
    except AdminError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    except PermissionError as e:
        print(f"error: {e} (run as root)", file=sys.stderr)
        return 1
    return 0


