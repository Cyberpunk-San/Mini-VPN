import subprocess
import sys
import threading
import time
import urllib.parse

VERSION = "2.0.0"
NAME_RE = re.compile(r"^[A-Za-z0-9._-]{1,32}$")
COMMUNITY_LIMIT = 5
PBKDF2_ITERATIONS = 310_000
MIN_PASSWORD = 10


class AdminError(Exception):
    """A problem the user can fix; shown without a traceback (HTTP 400 on the web)."""


# --------------------------------------------------------------------------
# Installation layout and files
# --------------------------------------------------------------------------

def parse_kv(path):
    """Parses the same 'key = value' format the C daemon reads."""
    values = {}
    with open(path, encoding="utf-8") as f:
        for n, raw in enumerate(f, 1):
            line = raw.split("#", 1)[0].strip()
            if not line:
                continue
            if "=" not in line:
                raise AdminError(f"{path}:{n}: expected 'key = value'")
            key, value = (s.strip() for s in line.split("=", 1))
            values[key] = value
    return values


def atomic_write(path, text, mode=0o600, group=None):
    """Write-then-rename so the daemon never reads a half-written file."""
    directory = os.path.dirname(os.path.abspath(path))
    tmp = os.path.join(directory, f".{os.path.basename(path)}.{secrets.token_hex(4)}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        if group is not None and os.geteuid() == 0:
            os.chown(tmp, 0, group)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)
        raise
    dfd = os.open(directory, os.O_RDONLY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)


class Device:
    __slots__ = ("id", "key", "ip", "status", "created", "name")

    def __init__(self, id, key, ip, status, created, name):
        self.id, self.key, self.ip, self.status, self.created, self.name = id, key, ip, status, created, name

    def line(self):
        return f"{self.id} {self.key} {self.ip} {self.status} {self.created} {self.name}\n"

    def public(self):
        return {"id": self.id, "name": self.name, "ip": self.ip, "status": self.status, "created": self.created}


class Install:
    """Paths and settings of one minivpn server installation."""

    def __init__(self, etc=None):
        self.etc = etc or os.environ.get("MINIVPN_ETC", "/etc/minivpn")
        self.server_conf = os.path.join(self.etc, "server.conf")
        self.admin_conf = os.path.join(self.etc, "admin.conf")
        self.audit_log = os.path.join(self.etc, "audit.log")
        self.lock_path = os.path.join(self.etc, ".admin.lock")

    @property
    def conf(self):
        if not os.path.exists(self.server_conf):
            raise AdminError(f"{self.server_conf} not found. Run: minivpn-admin init --endpoint <public-host-or-ip>")
        return parse_kv(self.server_conf)

    def setting(self, key, default=None):
        return self.conf.get(key, default)

    @property
    def devices_path(self):
        return self.setting("devices", os.path.join(self.etc, "devices"))

    @property
    def license_path(self):
        return self.setting("license", os.path.join(self.etc, "license.key"))

    @property
    def control_path(self):
        return self.setting("control_socket", "/run/minivpn/control.sock")

    @property
    def subnet(self):
        try:
            return ipaddress.ip_network(self.setting("subnet", "10.8.0.0/24"), strict=False)
        except ValueError as e:
            raise AdminError(f"invalid subnet in {self.server_conf}: {e}")

    @property
    def server_ip(self):
        return self.subnet.network_address + 1

    @property
    def service_gid(self):
        """Group that may read the registry: the daemon drops to this user."""
        user = self.setting("user")
        if not user:
            return None
        try:
            return pwd.getpwnam(user).pw_gid
        except KeyError:
            return None

    @contextlib.contextmanager
    def locked(self):
        fd = os.open(self.lock_path, os.O_RDWR | os.O_CREAT, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
            yield
        finally:
            fcntl.flock(fd, fcntl.LOCK_UN)
            os.close(fd)

    # -- device registry ---------------------------------------------------

    def load_devices(self):
        path = self.devices_path
        if not os.path.exists(path):
            return []
        devices = []
        with open(path, encoding="utf-8") as f:
            for n, raw in enumerate(f, 1):
                line = raw.split("#", 1)[0].strip()
                if not line:
                    continue
                parts = line.split()
                if len(parts) != 6:
                    raise AdminError(f"{path}:{n}: malformed line; fix it by hand before using minivpn-admin")
                did, key, ip, status, created, name = parts
                devices.append(Device(did, key, ip, status, int(created), name))
        return devices

    def save_devices(self, devices):
        header = (
            "# minivpn device registry - managed by minivpn-admin.\n"
            "# Contains secret keys. Fields: device_id key tunnel_ip status created name\n"
        )
        atomic_write(self.devices_path, header + "".join(d.line() for d in devices),
                     mode=0o640, group=self.service_gid)

    # -- daemon interaction -------------------------------------------------

    def control(self, command, timeout=3.0):
        """One request to the running daemon; None if it isn't running."""
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.settimeout(timeout)
                s.connect(self.control_path)
                s.sendall(command.encode() + b"\n")
                chunks = []
                while True:
                    chunk = s.recv(65536)
                    if not chunk:
                        break
                    chunks.append(chunk)
            return json.loads(b"".join(chunks) or b"{}")
        except (OSError, ValueError):
            return None

    def license_info(self, path=None):
        binary = os.environ.get("MINIVPN_BIN") or shutil.which("minivpn") or "/usr/sbin/minivpn"
        try:
            out = subprocess.run([binary, "license-info", "--license", path or self.license_path],
                                 capture_output=True, text=True, timeout=10, check=True)
            return json.loads(out.stdout)
        except (OSError, subprocess.SubprocessError, ValueError):
            return {"status": "unknown", "edition": "community", "customer": "", "expires": "",
                    "license_id": "", "max_devices": COMMUNITY_LIMIT,
                    "message": f"could not run {binary} to check the license"}


