# Operations (shared by the CLI and the web dashboard)
# --------------------------------------------------------------------------

class Admin:
    def __init__(self, install, actor):
        self.inst = install
        self.actor = actor

    def audit(self, action, device="", detail=""):
        entry = {"time": int(time.time()), "actor": self.actor, "action": action,
                 "device": device, "detail": detail}
        fd = os.open(self.inst.audit_log, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o640)
        with os.fdopen(fd, "a", encoding="utf-8") as f:
            f.write(json.dumps(entry) + "\n")

    def audit_tail(self, limit=50):
        try:
            with open(self.inst.audit_log, encoding="utf-8") as f:
                lines = f.readlines()[-limit:]
        except FileNotFoundError:
            return []
        out = []
        for line in reversed(lines):
            with contextlib.suppress(ValueError):
                out.append(json.loads(line))
        return out

    def notify_daemon(self):
        reply = self.inst.control("reload")
        if reply is None:
            return "server is not running; changes apply when it starts"
        if not reply.get("ok"):
            return f"server could not reload: {reply.get('error', 'unknown error')}"
        kicked = reply.get("kicked", 0)
        msg = f"server reloaded ({reply.get('devices_loaded', 0)} device(s) active"
        msg += f", {kicked} disconnected)" if kicked else ")"
        return msg

    def license(self):
        return self.inst.license_info()

    def _find(self, devices, name):
        for d in devices:
            if d.name == name:
                return d
        raise AdminError(f"no device named '{name}'")

    def _check_limit(self, devices, extra=1):
        lic = self.license()
        active = sum(d.status == "active" for d in devices)
        limit = int(lic.get("max_devices", COMMUNITY_LIMIT))
        if active + extra > limit:
            if lic.get("status") == "valid":
                raise AdminError(f"your license allows {limit} active devices ({active} in use). "
                                 "Disable or revoke a device, or upgrade the license.")
            raise AdminError(f"the free Community edition allows {limit} active devices. "
                             "Install a Business license to add more: minivpn-admin license install <file>")

    def _allocate_ip(self, devices, requested=None):
        net = self.inst.subnet
        used = {d.ip for d in devices}
        reserved = {str(net.network_address), str(net.broadcast_address), str(self.inst.server_ip)}
        if requested:
            try:
                ip = ipaddress.ip_address(requested)
            except ValueError:
                raise AdminError(f"'{requested}' is not an IPv4 address")
            if ip not in net or str(ip) in reserved:
                raise AdminError(f"{ip} is not a usable address in {net}")
            if str(ip) in used:
                raise AdminError(f"{ip} is already assigned")
            return str(ip)
        for host in net.hosts():
            if str(host) not in used and str(host) not in reserved:
                return str(host)
        raise AdminError(f"no free addresses left in {net}")

    def client_config(self, device):
        endpoint = self.inst.setting("endpoint")
        if not endpoint:
            raise AdminError(f"set 'endpoint = <public host or IP>' in {self.inst.server_conf} first")
        port = self.inst.setting("port", "51900")
        server = endpoint if ":" in endpoint else f"{endpoint}:{port}"
        created = dt.datetime.fromtimestamp(device.created).strftime("%Y-%m-%d")
        return (
            f"# minivpn device configuration for \"{device.name}\" (created {created})\n"
            "# Keep this file secret: anyone holding it can join your VPN as this device.\n"
            f"# Connect:  sudo minivpn client --config {device.name}.conf\n"
            f"name = {device.name}\n"
            f"server = {server}\n"
            f"device_id = {device.id}\n"
            f"key = {device.key}\n"
            "# route = 192.168.1.0/24      # reach a network behind the server\n"
            "# redirect_gateway = yes      # send all internet traffic through the VPN\n"
        )

    # -- mutations ----------------------------------------------------------

    def add_device(self, name, ip=None):
        if not NAME_RE.match(name or ""):
            raise AdminError("device names may use letters, digits, '.', '_' and '-' (max 32)")
        with self.inst.locked():
            devices = self.inst.load_devices()
            if any(d.name == name for d in devices):
                raise AdminError(f"a device named '{name}' already exists")
            self._check_limit(devices)
            device = Device(secrets.token_hex(16), secrets.token_hex(32), self._allocate_ip(devices, ip),
                            "active", int(time.time()), name)
            config = self.client_config(device)  # fail before saving if endpoint is missing
            devices.append(device)
            self.inst.save_devices(devices)
        self.audit("add", name, device.ip)
        return device, config, self.notify_daemon()

    def set_status(self, name, status):
        with self.inst.locked():
            devices = self.inst.load_devices()
            device = self._find(devices, name)
            if device.status == status:
                return f"'{name}' is already {status}"
            if status == "active":
                self._check_limit(devices)
            device.status = status
            self.inst.save_devices(devices)
        self.audit("enable" if status == "active" else "disable", name)
        return self.notify_daemon()

    def revoke(self, name):
        with self.inst.locked():
            devices = self.inst.load_devices()
            device = self._find(devices, name)
            devices.remove(device)
            self.inst.save_devices(devices)
        self.audit("revoke", name, device.ip)
        return self.notify_daemon()

    def kick(self, name):
        device = self._find(self.inst.load_devices(), name)
        reply = self.inst.control(f"kick {device.id}")
        if reply is None:
            raise AdminError("server is not running")
        if not reply.get("ok"):
            raise AdminError(reply.get("error", "kick failed"))
        self.audit("kick", name)
        return f"'{name}' disconnected (it may reconnect; use disable to block it)"

    def show_config(self, name):
        return self.client_config(self._find(self.inst.load_devices(), name))

    def install_license(self, text):
        if len(text) > 4096:
            raise AdminError("that does not look like a license file")
        staging = os.path.join(self.inst.etc, f".license.{secrets.token_hex(4)}.check")
        atomic_write(staging, text, mode=0o640, group=self.inst.service_gid)
        try:
            info = self.inst.license_info(staging)
            if info.get("status") != "valid":
                raise AdminError(f"license not installed: {info.get('message', 'invalid')}")
            os.replace(staging, self.inst.license_path)
        finally:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(staging)
        self.audit("license", "", f"{info['customer']} / {info['max_devices']} devices / until {info['expires']}")
        return info, self.notify_daemon()

    # -- read model for list/status/dashboard --------------------------------

    def overview(self):
        devices = self.inst.load_devices()
        status = self.inst.control("status")
        license = status["license"] if status and status.get("ok") else self.license()
        sessions = {s["device_id"]: s for s in (status or {}).get("sessions", [])}
        rows = []
        for d in devices:
            row = d.public()
            s = sessions.get(d.id)
            row["online"] = s is not None
            if s:
                row.update({k: s[k] for k in ("endpoint", "connected_at", "idle", "rx_bytes", "tx_bytes",
                                              "rx_packets", "tx_packets", "session")})
            rows.append(row)
        server = None
        if status and status.get("ok"):
            server = {k: v for k, v in status.items() if k not in ("sessions", "license")}
        return {
            "server": server,
            "license": license,
            "devices": rows,
            "active_devices": sum(d.status == "active" for d in devices),
            "endpoint": self.inst.setting("endpoint", ""),
            "subnet": str(self.inst.subnet),
            "audit": self.audit_tail(30),
        }


